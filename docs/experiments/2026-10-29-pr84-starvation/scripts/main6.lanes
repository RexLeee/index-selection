# Round-6 batch, Host3: WebCrawler 498a195, the fixed per-host interval removed after review.
# AutoThrottle's slot delay is the only per-host pacing; isel (iselsim) keeps the 0.208 req/s
# average with MIN_GAP_S. Same list and isel settings as round 5's A3. Page weight w = 0.31: round 6a
# (w = 0.42) aborted at warm-up, R0 25.3 req/s at 100 % CPU, as Host3 now also serves a
# production YugabyteDB node; 0.42 x 25.3 / 34.5 = 0.31.
# B2: is the cap's +1 needed. T0/T4: the cap follows TARGET_CONCURRENCY with no code change.
# F0/F1: 1 in 10 hosts answers 429 to every page, 5 % of requests redirect.
# name tree policy warm after env
R0 /home/r14725023/r3/wc-498a195 weighted 900 3600 MOCK_LINKS=277 MOCK_TEXT_REPEAT=3696 MEDIAN_S=1.3
B1 /home/r14725023/r3/wc-498a195 weighted 900 3600 MOCK_LINKS=277 MOCK_TEXT_REPEAT=3696 MEDIAN_S=1.3 SIZES=/home/r14725023/r3/sizes/w03_sizes.txt MIN_GAP_S=4.8 HOST_DOCS_PER_JOB=240 MAX_JOBS_INFLIGHT=32 STATUS_POLL_S=15 ARCHIVE_INTERVAL_S=15
B2 /home/r14725023/r3/wc-498a195 weighted 900 3600 MOCK_LINKS=277 MOCK_TEXT_REPEAT=3696 MEDIAN_S=1.3 SIZES=/home/r14725023/r3/sizes/w03_sizes.txt MIN_GAP_S=4.8 HOST_DOCS_PER_JOB=240 MAX_JOBS_INFLIGHT=32 STATUS_POLL_S=15 ARCHIVE_INTERVAL_S=15 HEADROOM=0
T0 /home/r14725023/r3/wc-498a195 weighted 900 3600 MOCK_LINKS=277 MOCK_TEXT_REPEAT=3696 MEDIAN_S=1.3 TARGET=4.0
T4 /home/r14725023/r3/wc-498a195 weighted 900 3600 MOCK_LINKS=277 MOCK_TEXT_REPEAT=3696 MEDIAN_S=1.3 SIZES=/home/r14725023/r3/sizes/w03_sizes.txt MIN_GAP_S=4.8 HOST_DOCS_PER_JOB=240 MAX_JOBS_INFLIGHT=32 STATUS_POLL_S=15 ARCHIVE_INTERVAL_S=15 TARGET=4.0
F0 /home/r14725023/r3/wc-498a195 weighted 900 3600 MOCK_LINKS=277 MOCK_TEXT_REPEAT=3696 MEDIAN_S=1.3 MOCK_429_EVERY=10 MOCK_REDIRECT_FRAC=0.05
